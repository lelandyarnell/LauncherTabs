<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/manage_tab_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/small_margin"
    android:gravity="center_vertical"
    android:minHeight="@dimen/manage_tab_card_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/activity_margin"
    android:paddingEnd="@dimen/small_margin">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/manage_tab_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="@dimen/bigger_text_size"
        tools:text="Social" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/manage_tab_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/medium_margin"
        android:layout_weight="1"
        android:alpha="0.7"
        android:maxLines="1"
        android:textSize="@dimen/normal_text_size"
        tools:text="13 apps" />

    <ImageView
        android:id="@+id/manage_tab_delete"
        android:layout_width="@dimen/manage_tab_button_size"
        android:layout_height="@dimen/manage_tab_button_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete"
        android:padding="@dimen/medium_margin"
        android:src="@drawable/ic_delete_vector" />

    <ImageView
        android:id="@+id/manage_tab_add"
        android:layout_width="@dimen/manage_tab_button_size"
        android:layout_height="@dimen/manage_tab_button_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/add_to_tab"
        android:padding="@dimen/medium_margin"
        android:src="@drawable/ic_plus_vector" />

</LinearLayout>
